[Unit]
Description=Actualizar Shutdown Control desde GitHub
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=shutdown-deploy
Group=shutdown-deploy
WorkingDirectory=/opt/shutdown-control
Environment=APP_DIR=/opt/shutdown-control
Environment=DEPLOY_BRANCH=main
Environment=HOME=/var/lib/shutdown-control-deploy
StateDirectory=shutdown-control-deploy
ExecStart=/usr/bin/bash /opt/shutdown-control/scripts/deploy-vps.sh

# Endurecimiento básico sin impedir Git ni Docker.
NoNewPrivileges=true
PrivateTmp=true

